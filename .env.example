APP_NAME=API de Endereços
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enderecos
VIACEP_BASE_URL=https://viacep.com.br/ws
HTTP_TIMEOUT=3
# Tentativas por consulta ao ViaCEP e espera inicial entre elas (dobra a cada repetição)
VIACEP_TENTATIVAS=3
VIACEP_BACKOFF_INICIAL=0.2
API_KEY=troque-por-uma-chave-forte
# Requisições por cliente a cada janela (em segundos). 0 desliga o limite.
RATE_LIMIT_REQUISICOES=60
RATE_LIMIT_JANELA=60
# Usadas pelo docker-compose. DATABASE_URL acima é para rodar a API fora do Docker;
# dentro do compose a URL é montada com estes valores e o host "db".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enderecos

# Portas expostas na máquina (opcional)
API_PORT=8000
POSTGRES_PORT=5432
